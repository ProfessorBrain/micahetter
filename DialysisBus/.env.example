# Web browser configuration
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Database
POSTGRES_DB=dialysis_transit
POSTGRES_USER=dialysis_app
POSTGRES_PASSWORD=change-this-for-local-development
DATABASE_URL=postgresql+psycopg://dialysis_app:change-this-for-local-development@db:5432/dialysis_transit
PUBLIC_DATABASE_URL=postgresql+psycopg://dialysis_readonly:change-this-readonly-password@db:5432/dialysis_transit

# Source configuration
CMS_DATASET_ID=23ew-n7w9
CMS_DATASTORE_RESOURCE_INDEX=0
BTS_NTM_STOPS_FEATURESERVER=https://services.arcgis.com/xOi1kZaI0eWDREZv/arcgis/rest/services/NTAD_National_Transit_Map_Stops/FeatureServer/0
DATA_SNAPSHOT_DIR=/data/raw

# Service behavior
APP_ENV=development
APP_VERSION=0.1.0
API_RATE_LIMIT_PER_MINUTE=120
RAW_POINT_LIMIT=20000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
